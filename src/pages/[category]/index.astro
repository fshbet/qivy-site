---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FollowCta from '../../components/FollowCta.astro';
import {
  CATEGORIES,
  CATEGORY_META,
  getArticlesByCategory,
  type Category,
} from '../../lib/content';

export const getStaticPaths: GetStaticPaths = () =>
  CATEGORIES.map((category) => ({ params: { category } }));

const category = Astro.params.category as Category;
const meta = CATEGORY_META[category];
const articles = await getArticlesByCategory(category);

const isMaker = category === 'maker';

// On /maker/ the filament knowledge base is the main attraction, so the hub
// lists top-level Maker articles and points at the KB separately.
const listed = isMaker ? articles.filter((a) => !a.data.subcategory) : articles;
const filamentCount = isMaker
  ? articles.filter((a) => a.data.subcategory === 'filaments').length
  : 0;

const seoTitles: Record<Category, string> = {
  ai: 'AI — practical tools, prompts & local models | Qivy',
  automation: 'Automation — n8n, Python & API workflows | Qivy',
  tips: 'Tips & Tricks — Windows, browsers & software | Qivy',
  maker: 'Maker archive — 3D printing & filaments | Qivy',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    {
      '@type': 'ListItem',
      position: 2,
      name: meta.label,
      item: new URL(`/${category}/`, Astro.site).href,
    },
  ],
};
---

<BaseLayout
  title={seoTitles[category]}
  description={meta.blurb}
  schemas={[breadcrumbSchema]}
>
  <section class="hdr wrap">
    <Breadcrumbs crumbs={[{ label: meta.label }]} />
    <h1 style={`--c:${meta.accent}`}>{meta.label}</h1>
    <p class="lede">{meta.blurb}</p>

    {
      isMaker && (
        <aside class="archive-note">
          <strong>This is an archive.</strong> 3D printing was Qivy's earlier
          focus. These articles are kept because they are still useful — they
          are no longer what the site is about.
        </aside>
      )
    }

    {
      filamentCount > 0 && (
        <a class="kb-link" href="/maker/filaments/">
          <span>
            <strong>Filament knowledge base</strong>
            {filamentCount} reference pages — PLA, PETG, TPU, ABS, Nylon and more
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      )
    }

    <p class="count">
      {listed.length === 0
        ? 'No articles here yet.'
        : `${listed.length} article${listed.length === 1 ? '' : 's'}`}
    </p>
  </section>

  {
    listed.length > 0 ? (
      <section class="wrap grid" aria-labelledby="list-h">
        {/* Keeps the heading order h1 -> h2 -> h3 (card titles) without
            adding a visible heading the design does not need. */}
        <h2 id="list-h" class="sr-only">All {meta.label} articles</h2>
        {listed.map((a, i) => <ArticleCard article={a} featured={i === 0 && listed.length > 2} />)}
      </section>
    ) : (
      /*
        Honest empty state. The AI pillar starts empty by design
        (CONTENT_STRATEGY.md §6.3) — say so rather than render filler cards
        that look like content.
      */
      <section class="wrap">
        <div class="empty">
          <h2>Nothing published here yet</h2>
          <p>
            This section is being built. New {meta.label.toLowerCase()} articles
            are published as they are written and reviewed — follow the feed to
            see them first.
          </p>
          <a class="btn btn--primary" href="/rss.xml">Subscribe via RSS</a>
        </div>
      </section>
    )
  }

  <section class="section wrap">
    <FollowCta compact />
  </section>
</BaseLayout>

<style>
  .hdr {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-6);
  }

  h1 {
    margin-top: var(--sp-5);
    font-size: var(--fs-3xl);
    color: var(--c);
  }

  .lede {
    margin-top: var(--sp-4);
  }

  .archive-note {
    margin-top: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    border-left: 3px solid var(--accent-4);
    background: var(--accent-4-soft);
    border-radius: 0 var(--r) var(--r) 0;
    font-size: var(--fs-sm);
    color: var(--text-2);
    max-width: 68ch;
  }
  .archive-note strong {
    color: var(--text);
  }

  .kb-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    background: var(--bg-2);
    border: 1px solid var(--bd);
    border-radius: var(--r-l);
    transition: border-color 0.18s ease;
  }
  .kb-link:hover {
    border-color: var(--accent-4);
  }
  .kb-link strong {
    display: block;
    font-size: var(--fs-base);
    margin-bottom: var(--sp-1);
  }
  .kb-link span {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .kb-link svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--accent-4);
  }

  .count {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--bd);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  /* The featured card spans the row it leads. */
  .grid > :global(.card--featured) {
    grid-column: 1 / -1;
  }

  .empty {
    padding: var(--sp-8) var(--sp-6);
    text-align: center;
    background: var(--bg-2);
    border: 1px dashed var(--bd-md);
    border-radius: var(--r-xl);
  }
  .empty h2 {
    font-size: var(--fs-xl);
  }
  .empty p {
    max-width: 48ch;
    margin: var(--sp-3) auto var(--sp-5);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .kb-link {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
