---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticlesByCategory } from '../../../lib/content';

const all = await getArticlesByCategory('maker');
const filaments = all
  .filter((a) => a.data.subcategory === 'filaments')
  // Alphabetical, not chronological: this is reference material, so readers
  // are looking something up rather than reading the newest thing.
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Maker',
      item: new URL('/maker/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Filaments',
      item: new URL('/maker/filaments/', Astro.site).href,
    },
  ],
};
---

<BaseLayout
  title="3D Filament Knowledge Base — PLA, PETG, TPU, ABS | Qivy"
  description="Reference pages for 3D printing filaments: PLA, PETG, TPU, ABS, Nylon, brand comparisons, storage and India availability notes."
  schemas={[breadcrumbSchema]}
>
  <section class="hdr wrap">
    <Breadcrumbs
      crumbs={[{ label: 'Maker', href: '/maker/' }, { label: 'Filaments' }]}
    />
    <h1>3D Filament Knowledge Base</h1>
    <p class="lede">
      Material reference for 3D printing — properties, settings, brand notes and
      storage. Part of Qivy's Maker archive.
    </p>
    <p class="count">
      {filaments.length} reference page{filaments.length === 1 ? '' : 's'}
    </p>
  </section>

  {
    filaments.length > 0 ? (
      <section class="wrap grid" aria-labelledby="list-h">
        <h2 id="list-h" class="sr-only">All filament reference pages</h2>
        {filaments.map((a) => <ArticleCard article={a} />)}
      </section>
    ) : (
      <section class="wrap">
        <p class="empty">No filament reference pages published yet.</p>
      </section>
    )
  }
</BaseLayout>

<style>
  .hdr {
    padding-block: var(--sp-6);
  }
  h1 {
    margin-top: var(--sp-5);
    font-size: var(--fs-3xl);
    color: var(--accent-4);
  }
  .lede {
    margin-top: var(--sp-4);
  }
  .count {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--bd);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  .empty {
    padding: var(--sp-7);
    text-align: center;
    color: var(--text-2);
    border: 1px dashed var(--bd-md);
    border-radius: var(--r-xl);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
