---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import VerificationBadge from '../components/VerificationBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FollowCta from '../components/FollowCta.astro';
import {
  CATEGORY_META,
  articlePath,
  formatDate,
  isoDate,
  readingTime,
  wordCount,
  getRelated,
  getPrevNext,
  type Article,
} from '../lib/content';

export interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { data } = article;

const meta = CATEGORY_META[data.category];
const minutes = readingTime(article.body);
const words = wordCount(article.body);
const url = new URL(articlePath(article), Astro.site).href;

const related = await getRelated(article, 3);
const { prev, next } = await getPrevNext(article);

// A TOC on a short article is noise. 600 words is roughly where scanning
// starts to beat scrolling.
const showToc = words >= 600;

const crumbs = data.subcategory
  ? [
      { label: meta.label, href: `/${data.category}/` },
      { label: 'Filaments', href: `/${data.category}/${data.subcategory}/` },
      { label: data.title },
    ]
  : [{ label: meta.label, href: `/${data.category}/` }, { label: data.title }];

const ogImage = data.image ?? '/og-default.png';

// ── Structured data ───────────────────────────────────────────────────────
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.metaDescription,
  image: new URL(ogImage, Astro.site).href,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: 'Qivy', url: Astro.site?.href },
  publisher: {
    '@type': 'Organization',
    name: 'Qivy',
    url: Astro.site?.href,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: meta.label,
  keywords: data.tags.join(', '),
  wordCount: words,
  inLanguage: 'en',
  ...(data.sources.length > 0 && { citation: data.sources }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.label,
      ...(c.href && { item: new URL(c.href, Astro.site).href }),
    })),
  ],
};
---

<BaseLayout
  title={data.seoTitle}
  description={data.metaDescription}
  image={ogImage}
  ogType="article"
  publishedTime={data.publishDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.publishDate).toISOString()}
  schemas={[articleSchema, breadcrumbSchema]}
>
  <article class="art">
    <header class="head wrap">
      <Breadcrumbs crumbs={crumbs} />

      <div class="badges">
        <CategoryBadge category={data.category} href />
        <VerificationBadge
          verification={data.verification}
          sourceCount={data.sources.length}
        />
      </div>

      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>

      <div class="meta">
        <time datetime={isoDate(data.publishDate)}>
          {formatDate(data.publishDate)}
        </time>
        {
          data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={isoDate(data.updatedDate)}>
                  {formatDate(data.updatedDate)}
                </time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
    </header>

    {
      data.image && (
        <div class="hero wrap">
          <img
            src={data.image}
            alt={data.imageAlt}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="grid wrap">
      <div class="col-main">
        {showToc && <div class="toc-mobile"><TableOfContents headings={headings} /></div>}

        <div class="prose">
          <slot />
        </div>

        {
          data.sources.length > 0 && (
            <section class="sources" aria-labelledby="src-h">
              <h2 id="src-h">Sources</h2>
              <ol>
                {data.sources.map((s) => (
                  <li>
                    <a href={s} target="_blank" rel="noopener noreferrer">{s}</a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <div class="share-row">
          <ShareLinks title={data.title} url={url} />
        </div>

        {
          (prev || next) && (
            <nav class="pn" aria-label="More in this category">
              {prev ? (
                <a class="pn-item" href={articlePath(prev)} rel="prev">
                  <span class="pn-lbl">← Previous</span>
                  <span class="pn-title">{prev.data.title}</span>
                </a>
              ) : <div />}
              {next && (
                <a class="pn-item pn-next" href={articlePath(next)} rel="next">
                  <span class="pn-lbl">Next →</span>
                  <span class="pn-title">{next.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </div>

      {
        showToc && (
          <aside class="col-side">
            <div class="sticky">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )
      }
    </div>

    {
      related.length > 0 && (
        <section class="related wrap" aria-labelledby="rel-h">
          <h2 id="rel-h">Related articles</h2>
          <div class="rel-grid">
            {related.map((r) => <ArticleCard article={r} />)}
          </div>
        </section>
      )
    }

    <div class="wrap cta-wrap">
      <FollowCta compact />
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-top: var(--sp-6);
    max-width: calc(var(--max-w-prose) + 2 * var(--gutter) + 6rem);
  }

  .badges {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-5);
  }

  h1 {
    margin-top: var(--sp-4);
    font-size: var(--fs-3xl);
  }

  .summary {
    margin-top: var(--sp-4);
    font-size: var(--fs-lg);
    color: var(--text-2);
    max-width: var(--max-w-prose);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-5);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--bd);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .hero {
    margin-top: var(--sp-6);
  }
  .hero img {
    width: 100%;
    aspect-ratio: 40 / 21;
    object-fit: cover;
    border: 1px solid var(--bd);
    border-radius: var(--r-l);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-7);
    margin-top: var(--sp-6);
  }

  .toc-mobile {
    margin-bottom: var(--sp-6);
  }

  .sources {
    margin-top: var(--sp-7);
    padding: var(--sp-5);
    background: var(--bg-2);
    border: 1px solid var(--bd);
    border-radius: var(--r-l);
  }
  .sources h2 {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    margin-bottom: var(--sp-3);
  }
  .sources ol {
    list-style: decimal;
    padding-left: var(--sp-5);
    font-size: var(--fs-sm);
  }
  .sources li + li {
    margin-top: var(--sp-2);
  }
  .sources a {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .sources a:hover {
    text-decoration: underline;
  }

  .share-row {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--bd);
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }
  .pn-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    background: var(--bg-2);
    border: 1px solid var(--bd);
    border-radius: var(--r-l);
    transition: border-color 0.18s ease;
  }
  .pn-item:hover {
    border-color: var(--accent);
  }
  .pn-next {
    text-align: right;
  }
  .pn-lbl {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .pn-title {
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 1.4;
  }

  .related {
    margin-top: var(--sp-9);
  }
  .related h2 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--sp-5);
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--sp-4);
  }

  .cta-wrap {
    margin-top: var(--sp-8);
  }

  /* Side TOC only where there is room for it. */
  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
    .toc-mobile {
      display: none;
    }
    .sticky {
      position: sticky;
      top: calc(var(--header-h) + var(--sp-5));
    }
  }

  @media (max-width: 620px) {
    .pn {
      grid-template-columns: 1fr;
    }
    .pn-next {
      text-align: left;
    }
  }
</style>

<script>
  /**
   * Copy-code buttons.
   *
   * Added at runtime rather than via a rehype plugin: it keeps the Markdown
   * pipeline plain, and this is the only interactive element on an article
   * page. Highlighting itself is done at build time by Shiki, so no
   * highlighter ships to the browser.
   */
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');

    const status = document.createElement('span');
    status.className = 'sr-only';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied';
        btn.dataset.copied = 'true';
        status.textContent = 'Code copied to clipboard';
        setTimeout(() => {
          btn.textContent = 'Copy';
          delete btn.dataset.copied;
          status.textContent = '';
        }, 2000);
      } catch {
        // Don't claim success we didn't get.
        btn.textContent = 'Press Ctrl+C';
        status.textContent = 'Could not copy automatically — select the code and copy manually';
        setTimeout(() => {
          btn.textContent = 'Copy';
          status.textContent = '';
        }, 3000);
      }
    });

    wrapper.appendChild(btn);
    wrapper.appendChild(status);
  });
</script>
