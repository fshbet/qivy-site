---
const links = [
  { href: '/ai/', label: 'AI' },
  { href: '/automation/', label: 'Automation' },
  { href: '/tips/', label: 'Tips & Tricks' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="hdr">
  <nav class="hdr-inner wrap" aria-label="Main">
    <a class="brand" href="/" aria-label="Qivy — home">
      qivy<span aria-hidden="true">.</span>
    </a>

    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <button
        type="button"
        id="theme-toggle"
        class="icon-btn"
        aria-label="Switch to light theme"
      >
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="icon-btn menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile panel. hidden until opened, so it stays out of the tab order. -->
  <div id="mobile-menu" class="mobile" hidden>
    <ul class="wrap">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href="/maker/">Maker archive</a></li>
    </ul>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--bd);
  }

  .hdr-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }

  .brand {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.045em;
  }
  .brand span {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: var(--sp-5);
    align-items: center;
  }
  .links a {
    font-size: var(--fs-sm);
    color: var(--text-2);
    padding-block: var(--sp-2);
    transition: color 0.15s ease;
  }
  .links a:hover {
    color: var(--text);
  }
  /* Current section gets colour and an underline — not colour alone. */
  .links a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r);
    color: var(--text-2);
    border: 1px solid transparent;
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--bd-md);
  }
  .icon-btn svg {
    width: 19px;
    height: 19px;
  }

  .menu-btn {
    display: none;
  }

  /* Show the moon in dark mode, the sun in light mode. */
  .i-sun {
    display: none;
  }
  :global(html[data-theme='light']) .i-sun {
    display: block;
  }
  :global(html[data-theme='light']) .i-moon {
    display: none;
  }

  .mobile {
    border-top: 1px solid var(--bd);
    background: var(--bg-2);
  }
  .mobile ul {
    display: flex;
    flex-direction: column;
    padding-block: var(--sp-2);
  }
  .mobile a {
    display: block;
    padding: var(--sp-4) 0;
    font-size: var(--fs-base);
    color: var(--text-2);
    border-bottom: 1px solid var(--bd);
  }
  .mobile li:last-child a {
    border-bottom: 0;
  }
  .mobile a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
</style>

<script>
  // ── Theme toggle ──────────────────────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle');
  const syncLabel = () => {
    const light = document.documentElement.dataset.theme === 'light';
    themeBtn?.setAttribute(
      'aria-label',
      light ? 'Switch to dark theme' : 'Switch to light theme',
    );
  };
  syncLabel();

  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    if (next === 'light') root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('qivy-theme', next);
    } catch {
      /* Storage blocked — the toggle still works for this page view. */
    }
    syncLabel();
  });

  // ── Mobile menu ───────────────────────────────────────────────────────
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuBtn?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));

  // Escape closes and returns focus to the button, so keyboard users are
  // never stranded inside the panel.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setMenu(false);
      menuBtn?.focus();
    }
  });

  // Close on resize up to desktop, or the panel can be left open and hidden.
  window.addEventListener('resize', () => {
    if (window.innerWidth > 820 && menu && !menu.hidden) setMenu(false);
  });
</script>
