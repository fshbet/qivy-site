# Qivy — environment template.
# Copy to .env and fill in. NEVER commit .env.
# Nothing here is required to build or run the site; these are only for the
# daily content pipeline, which stores its real credentials in n8n's
# credential store rather than here.

# Optional: analytics. Leave blank to install no analytics at all.
# PUBLIC_PLAUSIBLE_DOMAIN=qivy.in

# Optional: newsletter provider endpoint, once one is chosen.
# The site currently ships an RSS link instead of a subscribe form.
# PUBLIC_NEWSLETTER_ENDPOINT=
